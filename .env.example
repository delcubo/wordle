# Адрес админки (без слэшей) — по умолчанию "alvipa". Репозиторий публичный, так что
# на проде задайте свой, непубличный адрес, например: ADMIN_PATH=my-secret-path
ADMIN_PATH=alvipa

# Пароль администратора для входа в админку
ADMIN_PASSWORD=change-me

# Ключ для подписи cookie-сессии администратора — сгенерируйте случайную строку
# (например: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-too

# База данных (Railway подставит автоматически при подключении PostgreSQL-аддона)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Часовой пояс для расчёта "какой сегодня день розыгрыша" (публикация слова дня)
TOURNAMENT_TIMEZONE=Europe/Moscow

# Публичный адрес сайта — используется только для справки/логов, ссылки на
# участников строятся на фронтенде от текущего домена автоматически
SITE_URL=https://your-site.up.railway.app
